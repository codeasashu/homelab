####################################################################
# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored; .env.example is tracked.
# Every ${VAR} referenced by docker-compose.yml is listed here.
# "Optional" = compose has a built-in default; only set to override.
####################################################################

#### HOST / IDENTITY (de-hardcoded from compose) — all optional ####
# Daily LAN access is by this static IP (Toshiba: DHCP off, reserved .12).
LAN_IP=192.168.1.12
# Canonical owned domain — stable identity for pocket-id/Jellyfin/Seafile,
# independent of the Tailscale/Headscale name. Point it wherever via DNS.
PUBLIC_DOMAIN=codeasashu.in.eu.org
# Tailscale tailnet suffix used only in homepage's allowed-hosts wildcard.
TAILNET_SUFFIX=tailf65211.ts.net
# Timezone + run-as user applied across services.
TZ=Asia/Kolkata
PUID=1000
PGID=1000

#### IMMICH (required) ####
IMMICH_DB_USERNAME=postgres
IMMICH_DB_PASSWORD=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_DATA_LOCATION=./immich/postgres
IMMICH_VERSION=v2
IMMICH_UPLOAD_LOCATION=/mnt/primary/immich

#### SHARED POSTGRES (Linkwarden DB via ./postgres/init) ####
PG_PASS=postgres

#### SEAFILE (required) ####
SEAFILE_MYSQL_DB_PASSWORD=change-me
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=change-me
SEAFILE_SERVER_HOSTNAME=files.codeasashu.in.eu.org
SEAFILE_JWT_PRIVATE_KEY=change-me-to-a-long-random-string
# Extra comma-separated CSRF origins beyond the domain + LAN IP that compose
# already adds (e.g. "photos.codeasashu.in.eu.org"). Leave blank if none.
SEAFILE_CSRF_TRUSTED_ORIGINS=
#### SEAFILE (optional — defaults shown) ####
SEAFILE_SERVER_PROTOCOL=https
INIT_SEAFILE_ADMIN_EMAIL=me@example.com
INIT_SEAFILE_ADMIN_PASSWORD=asecret
# Feature toggles (compose defaults are fine for most setups):
# SEAFILE_LOG_TO_STDOUT=true
# ENABLE_GO_FILESERVER=true
# ENABLE_SEADOC=true
# ENABLE_SEAFDAV=false
# ENABLE_NOTIFICATION_SERVER=false
# ENABLE_SEAFILE_AI=false
# ENABLE_FACE_RECOGNITION=false
# ENABLE_METADATA_MANAGEMENT=false

#### LINKWARDEN / MEILISEARCH ####
# Linkwarden reads more from .env (NEXTAUTH_URL, etc.) — see upstream docs.
# Meilisearch reads MEILI_MASTER_KEY.
NEXTAUTH_SECRET=change-me
MEILI_MASTER_KEY=change-me

#### BACKREST (restic) — also read by backup2.sh ####
RESTIC_PASSWORD=change-me

#### POCKET-ID ####
POCKETID_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

#### CALIBRE-WEB-AUTOMATED (optional) ####
HARDCOVER_API_TOKEN=

#### HOMEPAGE WIDGET KEYS (optional) ####
HOMEPAGE_IMMICH_API_KEY=
HOMEPAGE_JELLYFIN_API_KEY=
